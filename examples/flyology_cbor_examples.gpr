with "../flyology_cbor.gpr";

project Flyology_CBOR_Examples is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("streaming_parser.adb", "bounded_writer.adb", "landing_samples.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatw.X");
   end Compiler;
end Flyology_CBOR_Examples;
